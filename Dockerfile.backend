# Dockerfile.backend — Kamra PMS Backend Service
FROM python:3.11-slim

# Install system build dependencies and MariaDB client libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    gcc \
    build-essential \
    libmariadb-dev \
    libmariadb-dev-compat \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy python package manifests, entrypoint script and application source
COPY pyproject.toml README.md backend_entrypoint.py ./
COPY kamra/ ./kamra/

# Install frappe framework and gunicorn WSGI server
RUN pip install --no-cache-dir frappe gunicorn werkzeug

ENV PYTHONUNBUFFERED=1
ENV PORT=3000
ENV FRAPPE_SITE="kamra.localhost"

EXPOSE 3000

CMD ["sh", "-c", "python backend_entrypoint.py && gunicorn -b 0.0.0.0:3000 --workers 2 --timeout 120 frappe.app:application"]
