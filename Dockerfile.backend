# Dockerfile.backend — Kamra PMS Backend Service
FROM python:3.11-slim

WORKDIR /workspace

# Copy backend dependencies and application code
COPY pyproject.toml README.md backend_server.py ./
COPY kamra/ ./kamra/

ENV PYTHONUNBUFFERED=1
ENV PORT=3000

EXPOSE 3000

CMD ["python", "backend_server.py"]
